# Copy to .env for local development. Safe local defaults only; never commit real secrets.

# General
# Environment: local, staging or production
APP_ENV=local
# Node environment: development, test or production
NODE_ENV=development
# Log level: debug, info, warn or error
LOG_LEVEL=info
# Public origin of the staff portal (quad-edu.com in production)
PUBLIC_WEB_URL=http://localhost:3000
# Origin of the platform console
CONSOLE_URL=http://localhost:3001
# Port the API listens on
API_PORT=4000

# Database
# Postgres URL for the app, connects as quad_app
DATABASE_URL=postgres://quad_app:quad_app@localhost:5432/quad
# Postgres URL for withPlatform, connects as quad_platform
DATABASE_PLATFORM_URL=postgres://quad_platform:quad_platform@localhost:5432/quad
# Postgres URL for migrations only, connects as quad_owner
DATABASE_OWNER_URL=postgres://quad_owner:quad_owner@localhost:5432/quad
# Maximum connections per pool
DATABASE_POOL_MAX=

# Redis
# Redis URL for queues, session cache, Socket.IO adapter and rate limits
REDIS_URL=redis://localhost:6379

# Sessions and tokens
# Secret for signing session cookies
SESSION_SECRET=
# HMAC secret for signed links
LINK_SIGNING_SECRET=
# Private key for signing parent access tokens
JWT_PRIVATE_KEY=
# Public key for verifying parent access tokens
JWT_PUBLIC_KEY=
# Local key for field-level encryption
FIELD_ENCRYPTION_KEY=
# AWS KMS key for field-level encryption
KMS_KEY_ID=

# Staff SSO
# Google SSO client id for staff
GOOGLE_CLIENT_ID=
# Google SSO client secret for staff
GOOGLE_CLIENT_SECRET=
# Microsoft SSO client id for staff
MICROSOFT_CLIENT_ID=
# Microsoft SSO client secret for staff
MICROSOFT_CLIENT_SECRET=

# Console sign-in
# Google sign-in client id for the console
CONSOLE_GOOGLE_CLIENT_ID=
# Google sign-in client secret for the console
CONSOLE_GOOGLE_CLIENT_SECRET=
# Allowed Workspace domain for console sign-in (quad-edu.com)
CONSOLE_GOOGLE_HD=
# Email, password and TOTP sign-in for seeded platform users; refused in production
CONSOLE_PASSWORD_LOGIN=true

# Local and test helpers
# Fixed one-time code for local and test use; refused in production
DEV_FIXED_OTP=000000
# Password for seeded accounts
SEED_PASSWORD=
# Number that accepts a fixed OTP for app-store review
STORE_REVIEW_PHONE=

# Files
# S3 endpoint: MinIO locally, empty on AWS
S3_ENDPOINT=http://localhost:9000
# S3 region
S3_REGION=
# Bucket for private files
S3_BUCKET_PRIVATE=
# Bucket for public files
S3_BUCKET_PUBLIC=
# S3 access key, local only
S3_ACCESS_KEY_ID=quadminio
# S3 secret key, local only
S3_SECRET_ACCESS_KEY=quadminio123
# CDN origin for public files
CDN_URL=
# CloudFront key pair id for signed download URLs
CLOUDFRONT_KEY_PAIR_ID=
# CloudFront private key for signed download URLs
CLOUDFRONT_PRIVATE_KEY=
# ClamAV host for upload scanning
CLAMAV_HOST=
# ClamAV port
CLAMAV_PORT=

# Email
# Email provider: smtp or ses
EMAIL_PROVIDER=
# SMTP URL (Mailpit locally)
SMTP_URL=smtp://localhost:1025
# AWS SES region
SES_REGION=
# SES configuration set for bounce and complaint events
SES_CONFIGURATION_SET=
# Sending domain for email (mail.quad-edu.com)
EMAIL_FROM_DOMAIN=
# Support inbox address
SUPPORT_INBOX=
# Sales inbox address
SALES_INBOX=

# SMS
# SMS provider: log or live
SMS_PROVIDER=
# Notify.lk user id
NOTIFYLK_USER_ID=
# Notify.lk API key
NOTIFYLK_API_KEY=
# Notify.lk default sender id (QUAD)
NOTIFYLK_DEFAULT_SENDER=
# Twilio account SID
TWILIO_ACCOUNT_SID=
# Twilio auth token
TWILIO_AUTH_TOKEN=
# Twilio messaging service SID
TWILIO_MESSAGING_SERVICE_SID=

# Push
# Push provider: log or fcm
PUSH_PROVIDER=
# Firebase project id
FCM_PROJECT_ID=
# Firebase service account JSON
FCM_SERVICE_ACCOUNT_JSON=

# Platform billing (Quad's own accounts, D20)
# Quad PayHere merchant id
PLATFORM_PAYHERE_MERCHANT_ID=
# Quad PayHere merchant secret
PLATFORM_PAYHERE_MERCHANT_SECRET=
# Quad Stripe secret key
PLATFORM_STRIPE_SECRET_KEY=
# Quad Stripe webhook secret
PLATFORM_STRIPE_WEBHOOK_SECRET=
# Use gateway sandboxes
PAYMENTS_SANDBOX=

# Public site
# Turnstile site key for the demo request form
TURNSTILE_SITE_KEY=
# Turnstile secret key for the demo request form
TURNSTILE_SECRET_KEY=
# Plausible analytics domain, empty to turn off
PLAUSIBLE_DOMAIN=

# Ask Quad
# Anthropic API key for Ask Quad
ANTHROPIC_API_KEY=
# Model for Ask Quad (claude-opus-5-5)
ASSISTANT_MODEL=
# Platform kill switch for Ask Quad
ASSISTANT_ENABLED=

# Parent app config
# Minimum iOS app version for force update
MIN_APP_VERSION_IOS=
# Minimum Android app version for force update
MIN_APP_VERSION_ANDROID=

# Observability
# OpenTelemetry collector endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=
# OpenTelemetry exporter headers
OTEL_EXPORTER_OTLP_HEADERS=
# OpenTelemetry service name
OTEL_SERVICE_NAME=
# Sentry DSN for the API
SENTRY_DSN=
# Sentry environment name
SENTRY_ENVIRONMENT=
# Sentry release id
SENTRY_RELEASE=

# Web public (build time)
# Environment name exposed to the web apps (build time)
NEXT_PUBLIC_APP_ENV=
# API URL exposed to the web apps (build time)
NEXT_PUBLIC_API_URL=
# Sentry DSN for the web apps (build time)
NEXT_PUBLIC_SENTRY_DSN=
# Turnstile site key for the web apps (build time)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Plausible domain for the web apps (build time)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
