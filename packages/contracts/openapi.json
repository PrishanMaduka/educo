{
  "openapi": "3.1.0",
  "info": {
    "title": "Quad API",
    "version": "0.0.0",
    "description": "School, parent and console routes. Errors are `{ code, message, fields? }`."
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "HealthLive": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthReady": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          },
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          },
          "redis": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          }
        },
        "required": [
          "status",
          "db",
          "redis"
        ]
      },
      "SesWebhookAck": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "SnsEnvelope": {
        "type": "object",
        "properties": {
          "Type": {
            "type": "string",
            "enum": [
              "Notification",
              "SubscriptionConfirmation",
              "UnsubscribeConfirmation"
            ]
          },
          "MessageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "TopicArn": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "Message": {
            "type": "string",
            "maxLength": 262144
          },
          "Timestamp": {
            "type": "string",
            "maxLength": 64,
            "format": "date-time"
          },
          "SignatureVersion": {
            "type": "string",
            "maxLength": 8
          },
          "Signature": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "SigningCertURL": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "Subject": {
            "type": "string",
            "maxLength": 512
          },
          "SubscribeURL": {
            "type": "string",
            "maxLength": 2048
          },
          "Token": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": [
          "Type",
          "MessageId",
          "TopicArn",
          "Message",
          "Timestamp",
          "SignatureVersion",
          "Signature",
          "SigningCertURL"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "person": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "firstName": {
                "type": "string"
              },
              "theme": {
                "type": "string",
                "enum": [
                  "system",
                  "light",
                  "dark"
                ]
              },
              "locale": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "firstName",
              "theme",
              "locale"
            ]
          },
          "school": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "shortName": {
                "type": "string"
              },
              "timeZone": {
                "type": "string"
              },
              "brand": {
                "type": "object",
                "properties": {
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "fill": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "fillDark": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "ink": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  }
                },
                "required": [
                  "color",
                  "fill",
                  "fillDark",
                  "ink"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "shortName",
              "timeZone",
              "brand"
            ]
          },
          "memberships": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tenantId": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "shortName": {
                  "type": "string"
                },
                "brandColor": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "roleNames": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "suspended": {
                  "type": "boolean"
                }
              },
              "required": [
                "tenantId",
                "name",
                "shortName",
                "brandColor",
                "roleNames",
                "suspended"
              ]
            }
          },
          "preview": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "roleId": {
                "type": "string",
                "format": "uuid"
              },
              "roleName": {
                "type": "string"
              },
              "sampleUser": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "name"
                ]
              }
            },
            "required": [
              "roleId",
              "roleName",
              "sampleUser"
            ]
          },
          "support": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "schoolName": {
                "type": "string"
              },
              "platformUserName": {
                "type": "string"
              }
            },
            "required": [
              "schoolName",
              "platformUserName"
            ]
          },
          "greeting": {
            "type": "object",
            "properties": {
              "period": {
                "type": "string",
                "enum": [
                  "morning",
                  "afternoon",
                  "evening",
                  "night"
                ]
              },
              "word": {
                "type": "string",
                "enum": [
                  "Good morning",
                  "Good afternoon",
                  "Good evening",
                  "Hello"
                ]
              }
            },
            "required": [
              "period",
              "word"
            ]
          }
        },
        "required": [
          "person",
          "school",
          "memberships",
          "preview",
          "support",
          "greeting"
        ]
      },
      "MeUpdateInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "theme": {
            "type": "string",
            "enum": [
              "system",
              "light",
              "dark"
            ]
          },
          "locale": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 35
          }
        }
      },
      "SessionSummaryList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "web",
                    "mobile"
                  ]
                },
                "deviceName": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "userAgent": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "lastSeenAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "current": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "kind",
                "deviceName",
                "userAgent",
                "createdAt",
                "lastSeenAt",
                "current"
              ]
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "summary": "The process is up",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthLive"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "summary": "Postgres and Redis answer",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Ready to serve traffic",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReady"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is down; the body names it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReady"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "summary": "This OpenAPI document",
        "tags": [
          "meta"
        ],
        "responses": {
          "200": {
            "description": "The OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/webhooks/ses": {
      "post": {
        "summary": "SES bounce and complaint events from SNS (signature version 2, pinned topic)",
        "tags": [
          "webhooks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SnsEnvelope"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesWebhookAck"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "The signed-in person, their school and brand, other schools, banners and greeting",
        "tags": [
          "me"
        ],
        "responses": {
          "200": {
            "description": "The signed-in person",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Change your name, theme or locale in this school (needs X-CSRF-Token)",
        "tags": [
          "me"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeUpdateInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The signed-in person, updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/sessions": {
      "get": {
        "summary": "Your signed-in devices, newest first",
        "tags": [
          "me"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of your sessions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionSummaryList"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/sessions/{id}": {
      "delete": {
        "summary": "Sign one of your devices out (needs X-CSRF-Token)",
        "tags": [
          "me"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
