{
  "name": "@quad/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./internal": {
      "types": "./src/internal.ts",
      "default": "./src/internal.ts"
    },
    "./admin": {
      "types": "./src/admin.ts",
      "default": "./src/admin.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:api": "vitest run --config vitest.api.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "reset": "tsx src/scripts/reset.ts"
  },
  "dependencies": {
    "@quad/contracts": "workspace:*",
    "drizzle-orm": "0.45.3",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@quad/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
