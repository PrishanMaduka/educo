# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# gen-l10n output (regenerated by flutter pub get / flutter gen-l10n)
/lib/l10n/app_localizations*.dart

# Diff images flutter test writes when a golden fails
test/goldens/failures/

# Release signing: written by fastlane from environment secrets, never committed
/android/key.properties
*.jks
*.keystore

# Firebase client configs for staging and production stay out of git (spec 02);
# see firebase/README.md
/android/app/src/*/google-services.json
/ios/config/*/GoogleService-Info.plist

# fastlane and Bundler output
/fastlane/report.xml
/fastlane/*.ipa
/vendor/bundle/
/.bundle/
