{
  "name": "@quad/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsup && node scripts/copy-migrations.mjs && node scripts/check-dist.mjs",
    "dev": "tsup --watch src --watch ../../packages/contracts/src --watch ../../packages/db/src --onSuccess \"node --enable-source-maps dist/main.js & node --enable-source-maps dist/worker.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "test": "vitest run",
    "test:api": "vitest run --config vitest.api.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "openapi:export": "tsx src/openapi/export.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@aws-sdk/client-sesv2": "3.1139.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/otel": "0.21.1",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@node-rs/argon2": "2.2.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-ioredis": "0.71.0",
    "@opentelemetry/instrumentation-pg": "0.75.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@sentry/node": "11.5.0",
    "bullmq": "6.3.11",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "intl-messageformat": "12.1.3",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nodemailer": "10.0.10",
    "openid-client": "6.8.8",
    "otplib": "13.5.0",
    "pg": "8.13.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@quad/config": "workspace:*",
    "@quad/contracts": "workspace:*",
    "@quad/db": "workspace:*",
    "@quad/domain": "workspace:*",
    "@quad/tokens": "workspace:*",
    "@swc/core": "1.16.13",
    "@types/node": "22.20.5",
    "socket.io-client": "4.8.3",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  }
}
